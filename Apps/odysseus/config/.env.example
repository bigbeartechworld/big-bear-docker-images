# Odysseus Environment Variables
# Copy to .env and edit.

# --- Auth & Security ---
AUTH_ENABLED=true
ODYSSEUS_ADMIN_PASSWORD=

# --- User mapping (entrypoint drops to these) ---
PUID=1000
PGID=1000

# --- Search ---
SEARXNG_INSTANCE=http://searxng:8080
# Leave blank to auto-generate a secret on first boot, or set a fixed one.
SEARXNG_SECRET=

# --- Vector store ---
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

# --- LLM (user supplied) ---
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=

# --- Notifications (ntfy sidecar) ---
# Defaults bind ntfy to loopback only. Override to expose it.
NTFY_BIND=127.0.0.1
NTFY_BASE_URL=http://localhost:8091
